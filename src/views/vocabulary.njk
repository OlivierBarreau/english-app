{% extends "layout.njk" %}

{% block title %} Vocabulary {% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-6">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center">
            <div class="bg-green-100 rounded-full p-3 mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Vocabulary Lessons</h1>
                <p class="text-sm text-gray-600">Expand your English word knowledge</p>
            </div>
        </div>
    </div>

    <div class="mb-6 relative">
        <div class="relative">
            <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input 
                type="text" 
                id="search-bar" 
                class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent shadow-sm"
                placeholder="Search for a vocabulary lesson..." 
                oninput="filterLessons()"
            />
        </div>
        <div id="search-results-count" class="text-sm text-gray-500 mt-2">
            Showing all {{ lessons.length }} lessons
        </div>
    </div>
    
    <div id="lessons-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        {% for lesson in lessons %}
            <div style="opacity: 1; visibility: visible;" class="lesson-card bg-white border border-gray-200 rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300 flex flex-col h-full">
                <div class="p-5 flex-grow">
                    {% if lesson.lesson_content.category %}
                        <div class="inline-block px-3 py-1 mb-3 text-xs font-semibold text-green-800 bg-green-100 rounded-full">
                            {{ lesson.lesson_content.category }}
                        </div>
                    {% endif %}
                    <h2 class="text-lg font-bold text-gray-800 mb-3 lesson-title">{{ lesson.lesson_title }}</h2>
                    <p class="text-gray-600 text-sm mb-4 lesson-description">{{ lesson.lesson_content.description }}</p>
                    
                    {% if lesson.lesson_content.words and lesson.lesson_content.words|length > 0 %}
                        <div class="mt-3">
                            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Featured words:</span>
                            <div class="flex flex-wrap gap-2 mt-2">
                                {% for word in lesson.lesson_content.words.slice(0, 4) %}
                                    <span class="px-2 py-1 text-xs bg-green-50 text-green-800 rounded-full border border-green-200">{{ word }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
                
                <div class="border-t border-gray-200 bg-gray-50 p-4 mt-auto">
                    <a href="vocabulary/lessons/{{ lesson.id }}" class="flex items-center justify-center px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors duration-200">
                        <span>Learn Vocabulary</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
    
    <div id="no-results" class="hidden text-center p-10 bg-gray-50 rounded-lg border border-gray-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="mt-2 text-lg font-medium text-gray-900">No lessons found</h3>
        <p class="mt-1 text-gray-500">Try adjusting your search term or browse all lessons.</p>        <button onclick="clearSearch()" class="mt-4 px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors duration-200">
            Show All Lessons
        </button>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initial count display
        updateResultsCount();
          // Add animation to cards on page load with debugging
        const lessonCards = document.querySelectorAll('.lesson-card');
        console.log("Found " + lessonCards.length + " vocabulary lesson cards to animate");
        
        lessonCards.forEach((card, index) => {
            // Make card visible immediately
            card.style.opacity = "1";
            card.style.visibility = "visible";
            
            // Add animation with delay
            setTimeout(() => {
                card.classList.add('animate-slide-in');
            }, 50 * index);
        });
        
        // Add event listener for search input
        const searchBar = document.getElementById('search-bar');
        searchBar.addEventListener('input', debounce(filterLessons, 300));
          // Add styles for animations
        const style = document.createElement('style');
        style.textContent = `
            .lesson-card {
                opacity: 1 !important;
                visibility: visible !important;
                transform: translateY(0);
                transition: all 0.4s ease-out;
            }
            
            .lesson-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            }
            
            @keyframes fadeIn {
                from { opacity: 0; }
                to { opacity: 1; }
            }
            
            @keyframes slideIn {
                from { 
                    opacity: 0.7;
                    transform: translateY(10px); 
                }
                to { 
                    opacity: 1;
                    transform: translateY(0); 
                }
            }
        `;
        document.head.appendChild(style);
    });
    
    // Debounce function to improve search performance
    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    function filterLessons() {
        const query = document.getElementById('search-bar').value.toLowerCase().trim();
        const lessonCards = document.querySelectorAll('.lesson-card');
        const lessonsGrid = document.getElementById('lessons-grid');
        const noResults = document.getElementById('no-results');
        let visibleCount = 0;
        
        // If query is empty, show all cards
        if (!query) {
            lessonCards.forEach(card => {
                card.classList.remove('hidden');
                // Apply fade-in animation
                card.style.animation = 'fadeIn 0.5s ease forwards';
                // Ensure card is visible
                card.style.opacity = "1";
                card.style.visibility = "visible";
            });
            lessonsGrid.classList.remove('hidden');
            noResults.classList.add('hidden');
            updateResultsCount();
            return;
        }

        lessonCards.forEach(card => {
            const title = card.querySelector('.lesson-title').textContent.toLowerCase();
            const description = card.querySelector('.lesson-description').textContent.toLowerCase();
            
            // Advanced search: check for word tags
            let wordMatch = false;
            const wordTags = card.querySelectorAll('.bg-green-50');
            
            if (wordTags) {
                wordTags.forEach(tag => {
                    if (tag.textContent.toLowerCase().includes(query)) {
                        wordMatch = true;
                        // Highlight matching tags
                        tag.classList.add('ring-2', 'ring-green-300');
                    } else {
                        tag.classList.remove('ring-2', 'ring-green-300');
                    }
                });
            }
            
            // Support for exact phrase matching with quotes
            let exactMatch = false;
            if (query.startsWith('"') && query.endsWith('"')) {
                const exactPhrase = query.slice(1, -1).trim();
                exactMatch = title.includes(exactPhrase) || description.includes(exactPhrase);
            }
            
            // Check for category match if available
            let categoryMatch = false;
            const categoryTag = card.querySelector('.inline-block.px-3.py-1.mb-3');
            if (categoryTag) {
                categoryMatch = categoryTag.textContent.toLowerCase().includes(query);
            }
            
            // Determine final match status
            const isMatch = title.includes(query) || 
                           description.includes(query) || 
                           wordMatch || 
                           exactMatch || 
                           categoryMatch;
            
            // Show or hide based on match with animation
            if (isMatch) {
                card.classList.remove('hidden');
                visibleCount++;
                // Apply highlighting to title and description based on match
                const titleEl = card.querySelector('.lesson-title');
                const descriptionEl = card.querySelector('.lesson-description');
                
                if (title.includes(query)) {
                    highlightText(titleEl, query);
                }
                  if (description.includes(query)) {
                    highlightText(descriptionEl, query);
                }
                
                // Apply entrance animation and ensure visibility
                card.style.animation = 'slideIn 0.4s ease-out forwards';
                card.style.opacity = "1";
                card.style.visibility = "visible";
            } else {
                card.classList.add('hidden');
            }
        });

        // Show/hide no results message
        lessonsGrid.classList.toggle('hidden', visibleCount === 0);
        noResults.classList.toggle('hidden', visibleCount > 0);
        
        // Update the results count
        updateResultsCount(visibleCount);
    }
    
    function highlightText(element, query) {
        // Basic highlighting functionality
        const text = element.textContent;
        const lowerText = text.toLowerCase();
        const index = lowerText.indexOf(query.toLowerCase());
        
        if (index >= 0) {
            const before = text.substring(0, index);
            const match = text.substring(index, index + query.length);
            const after = text.substring(index + query.length);
            
            element.innerHTML = before + 
                               '<span class="bg-yellow-100 px-0.5 rounded">' + 
                               match + 
                               '</span>' + 
                               after;
        }
    }

    function updateResultsCount(count) {
        const totalCount = document.querySelectorAll('.lesson-card').length;
        const countElement = document.getElementById('search-results-count');
        
        if (count === undefined || count === totalCount) {
            countElement.textContent = `Showing all ${totalCount} vocabulary lessons`;
        } else {
            countElement.textContent = `Found ${count} of ${totalCount} matching lessons`;
        }
    }    function clearSearch() {
        const searchBar = document.getElementById('search-bar');
        searchBar.value = '';
        
        // Reset any highlighting
        document.querySelectorAll('.lesson-card .bg-yellow-100').forEach(el => {
            const parent = el.parentNode;
            parent.textContent = parent.textContent; // This removes the highlight spans
        });
        
        // Reset word tags highlighting
        document.querySelectorAll('.bg-green-50').forEach(tag => {
            tag.classList.remove('ring-2', 'ring-green-300');
        });
        
        // Ensure all cards are visible with animation
        document.querySelectorAll('.lesson-card').forEach((card, index) => {
            card.style.opacity = "1";
            card.style.visibility = "visible";
            card.style.animation = 'slideIn 0.4s ease-out forwards';
        });
        
        filterLessons();
        searchBar.focus();
    }
</script>
{% endblock %}