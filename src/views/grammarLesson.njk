{% extends "layout.njk" %}

{% block title %} {{ lesson.lesson_title }} | Grammar {% endblock %}

{% block content %}
<div class="flex flex-col min-h-screen bg-gray-50">
    <!-- Lesson Header -->
    <div class="bg-white shadow">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div class="flex items-center mb-4 md:mb-0">
                    <div class="bg-blue-100 rounded-full p-3 mr-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800">{{ lesson.lesson_title }}</h1>
                        {% if lesson.lesson_level %}
                        <div class="mt-1 flex items-center">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                Level: {{ lesson.lesson_level }}
                            </span>
                        </div>
                        {% endif %}
                    </div>
                </div>
                
                <div class="flex gap-4">
                    <button
                        onclick="history.back()"
                        class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-md shadow transition duration-150 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Go Back
                    </button>
                    <button
                        onclick="window.location.href='/quiz/{{ lesson.id }}'"
                        class="inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-md shadow transition duration-150 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                        Start Quiz
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Progress -->
    <div class="bg-white border-t border-b border-gray-200 py-3">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center text-sm">
            <div class="text-gray-600">Category: <span class="font-medium">Grammar</span></div>
            <div class="flex items-center">
                {% if prevLesson %}
                <a href="/grammar/lessons/{{ prevLesson.id }}" class="text-blue-500 hover:text-blue-700 mr-6">Previous Lesson</a>
                {% endif %}
                {% if nextLesson %}
                <a href="/grammar/lessons/{{ nextLesson.id }}" class="text-blue-500 hover:text-blue-700">Next Lesson</a>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow py-8 overflow-y-auto">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-white shadow-md rounded-lg">
                <!-- Reading Progress Bar -->
                <div class="w-full h-1 bg-gray-100">
                    <div id="readingProgress" class="h-1 bg-blue-500" style="width: 0%"></div>
                </div>
                
                <!-- Lesson Content -->
                <div id="lessonContent" class="p-8 prose prose-blue max-w-none">
                    {{ lesson.lesson_content.description | safe }}
                </div>
                
                <!-- Bottom Navigation -->
                <div class="p-6 bg-gray-50 rounded-b-lg border-t border-gray-200 flex justify-between">
                    <button
                        onclick="history.back()"
                        class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-md transition duration-150 focus:outline-none">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Back
                    </button>
                    <button
                        onclick="window.location.href='/quiz/{{ lesson.id }}'"
                        class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-md shadow transition duration-150 focus:outline-none">
                        Complete & Continue
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    // Reading progress tracking
    const content = document.getElementById('lessonContent');
    const progressBar = document.getElementById('readingProgress');
    
    window.addEventListener('scroll', () => {
        if (content && progressBar) {
            // Calculate how much of the content has been scrolled through
            const windowHeight = window.innerHeight;
            const contentBox = content.getBoundingClientRect();
            const contentTop = contentBox.top;
            const contentHeight = contentBox.height;
            
            // Calculate the percentage based on how much is visible in the viewport
            let progress = 0;
            if (contentTop < 0) {
                // Content has scrolled up, calculate percentage scrolled
                progress = Math.min(100, (-contentTop / (contentHeight - windowHeight)) * 100);
            }
            
            // Update the progress bar width
            progressBar.style.width = `${progress}%`;
        }
    });
});
</script>
{% endblock %}
