{% extends "layout.njk" %}

{% block title %} Grammar {% endblock %}

{% block content %}

<div class="flex flex-col justify-start mt-8 pb-2 border-b border-gray-200 bg-white">
    <p class="text-3xl font-bold w-full max-w-2xl ml-10">
        {{ lesson.lesson_title }}
    </p>

    <div class="flex flex-row justify-end items-center mt-4 ml-10 pe-96">
        <div class="flex justify-end gap-4">
            <button
                onclick="history.back()"
                class="px-4 py-2 bg-blue-600 text-white shadow hover:bg-blue-700 transition duration-150 focus:outline-none focus:ring-2 focus:ring-blue-400">
                Go Back
            </button>
            <button
                onclick="window.location.href='/quiz/{{ lesson.lesson_id }}'"
                class=" px-4 py-2 bg-emerald-600 text-white shadow hover:bg-emerald-700 transition duration-150 focus:outline-none focus:ring-2 focus:ring-emerald-400">
                Start Quiz
            </button>
        </div>
    </div>
</div>

<div class="container mx-auto p-8 bg-white max-w-screen-md h-screen overflow-y-auto scrollbar-thin scrollbar-thumb-gray-400 scrollbar-track-gray-200">

{{ lesson.lesson_content.description | safe}}

</div>
{# 
<div class="my-4 ml-10">
    <p class="text-lg"><strong>Description:</strong> {{ lesson.lesson_content.description | safe}}</p>
    <p class="text-lg"><strong>Level:</strong> {{ lesson.lesson_level }}</p>
</div>

<div class="my-4 ml-10">
    <h2 class="text-xl font-semibold text-blue-800 mb-2">Examples</h2>
    <ul class="list-disc list-inside text-gray-700">
        {% for example in lesson.lesson_content.examples %}
            <li>{{ example }}</li>
        {% endfor %}
    </ul>
</div>

<div class="my-4 ml-10">
    <h2 class="text-xl font-semibold text-blue-800 mb-4">Exercises</h2>
    <div class="text-gray-700">
        {% for exercise in questions %}
            <div class="mb-6 p-4 border border-gray-300 rounded-lg shadow-md bg-white">
                <p class="text-lg font-semibold text-gray-800 mb-2">
                    {{ exercise.question_content.question }}
                </p>
                {% if exercise.question_type == "vocabulary" %}
                    <p class="text-sm text-gray-600 mb-2"><strong>Options:</strong></p>
                    <ul class="list-disc list-inside ml-4 text-gray-700">
                        {% for option in exercise.question_content.options %}
                            <li>{{ option }}</li>
                        {% endfor %}
                    </ul>
                {% elseif exercise.question_type == "grammar" %}
                    <p class="text-sm text-gray-600 mb-2"><strong>Grammar Explanation:</strong></p>
                    <p class="text-gray-700">{{ exercise.question_content.explanation }}</p>
                {% elseif exercise.question_type == "multiple-choice" %}
                    <div class="flex flex-col gap-2 ml-4 text-gray-700">
                        {% for option in exercise.question_content.options %}
                            <div>
                                <label class="inline-flex items-center">
                                    <input type="checkbox" name="option-{{ loop.index }}" value="{{ option }}" class="mr-2">
                                    {{ option }}
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                {% elseif exercise.question_type == "single-choice" %}
                    <p class="text-sm text-gray-600 mb-2"><strong>Options:</strong></p>
                    <ul class="list-disc list-inside ml-4 text-gray-700">
                        {% for option in exercise.question_content.options %}
                            <li>
                                <label class="inline-flex items-center">
                                    <input type="radio" name="option-{{ loop.index }}" value="{{ option }}" class="mr-2">
                                    {{ option }}
                                </label>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                <button 
                    onclick="verifyAnswer('{{ exercise.question_content.correctAnswer }}', this)" 
                    class="mt-4 px-6 py-2 bg-teal-600 text-white font-semibold rounded-lg hover:bg-teal-700 transition duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
                    disabled>
                    Check Answer
                </button>

                <script>
                    const button = document.querySelector('button[onclick^="verifyAnswer"]');
                    const parentDiv1 = button.parentElement;
                    const inputs = parentDiv1.querySelectorAll('input[name^="option"]');

                    inputs.forEach(input => {
                        input.addEventListener('change', () => {
                            button.disabled = !Array.from(inputs).some(input => input.checked);
                        });
                    });
                </script>
                <p class="mt-2 text-sm text-gray-700 hidden result-message"></p>
            </div>

            <script>
                function verifyAnswer(correctAnswer, button) {
                    const parentDiv2 = button.parentElement;
                    const selectedOption = parentDiv2.querySelector('input[name^="option"]:checked');
                    const selectedValue = selectedOption ? selectedOption.value : null;

                    const resultMessage = parentDiv2.querySelector('.result-message');
                    if (selectedValue === correctAnswer) {
                        resultMessage.textContent = "Correct!";
                        resultMessage.classList.remove('hidden', 'text-red-500');
                        resultMessage.classList.add('text-green-500');
                    } else {
                        resultMessage.textContent = "Incorrect. Try again.";
                        resultMessage.classList.remove('hidden', 'text-green-500');
                        resultMessage.classList.add('text-red-500');
                    }
                }
            </script>
        {% endfor %}
    </div>
</div> #}

