{% extends "layout.njk" %}

{% block title %} Quiz - {{ lesson.lesson_title }} {% endblock %}

{% block content %}
<div class="flex flex-col min-h-screen bg-gray-50">
    <!-- Quiz Header -->
    <div class="bg-white shadow">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div class="flex items-center mb-4 md:mb-0">
                    <div class="bg-blue-100 rounded-full p-3 mr-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800">Quiz: {{ lesson.lesson_title }}</h1>
                        {% if lesson.lesson_level %}
                        <div class="mt-1 flex items-center">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                Level: {{ lesson.lesson_level }}
                            </span>
                        </div>
                        {% endif %}
                    </div>
                </div>
                
                <div class="flex items-center bg-blue-50 border-l-4 border-blue-500 p-4 rounded">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="ml-2 text-blue-700">Answer all questions and submit to complete the quiz</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quiz Form -->
    <div class="flex-grow py-8">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <form id="quizForm" action="/quiz/{{ lesson.id }}/submit" method="POST" class="bg-white shadow-md rounded-lg overflow-hidden">
                <!-- Quiz Progress Bar -->
                <div class="relative h-2 bg-gray-200">
                    <div id="quizProgress" class="absolute top-0 left-0 h-full bg-blue-500" style="width: 0%"></div>
                </div>

                <!-- Questions -->
                <div class="p-6">
                    <div class="mb-6">
                        <p class="text-sm text-gray-500">Complete all questions to progress:</p>
                    </div>

                    {% for question in questions %}
                    <div class="question-container mb-10 p-6 border border-gray-200 rounded-md" data-question-id="{{ question.id }}">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">
                            Question {{ loop.index }}: {{ question.question_content.question }}
                        </h3>

                        <div class="space-y-3 pl-4">
                            {% if question.question_type == 'MCQ' or question.question_type == 'multiple-choice' or question.question_type == 'grammar' or question.question_type == 'vocabulary' %}
                                {% for option in question.question_content.options %}
                                <div class="flex items-center">
                                    <input type="radio" id="q{{ question.id }}-option{{ loop.index }}" name="q{{ question.id }}" value="{{ option }}" class="quiz-input h-4 w-4 text-blue-600 focus:ring-blue-500">
                                    <label for="q{{ question.id }}-option{{ loop.index }}" class="ml-3 block text-sm font-medium text-gray-700">
                                        {{ option }}
                                    </label>
                                </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                        
                        <div class="mt-4 hidden feedback-message"></div>
                    </div>
                    {% endfor %}
                </div>

                <!-- Submit Section -->
                <div class="p-6 bg-gray-50 border-t border-gray-200 flex justify-between items-center">
                    <button 
                        type="button"
                        onclick="window.location.href='/program/{{ user.current_program_id }}/lessons/{{ lesson.id }}'"
                        class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Return to Lesson
                    </button>
                    
                    <button 
                        type="submit" 
                        id="submitQuiz"
                        class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        Submit Answers
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const quizForm = document.getElementById('quizForm');
    const submitBtn = document.getElementById('submitQuiz');
    const quizProgress = document.getElementById('quizProgress');
    const questions = document.querySelectorAll('.question-container');
    const inputs = document.querySelectorAll('.quiz-input');
    
    // Function to update the progress bar
    function updateProgress() {
        const totalQuestions = questions.length;
        const answeredQuestions = Array.from(questions).filter(question => {
            const questionInputs = question.querySelectorAll('.quiz-input');
            return Array.from(questionInputs).some(input => input.checked);
        }).length;
        
        const progressPercentage = (answeredQuestions / totalQuestions) * 100;
        quizProgress.style.width = `${progressPercentage}%`;
    }
    
    // Listen for changes to the quiz inputs
    inputs.forEach(input => {
        input.addEventListener('change', () => {
            updateProgress();
        });
    });
    
    // Form submission handler
    quizForm.addEventListener('submit', function(e) {
        e.preventDefault(); // Prevent default form submission
        
        // Prepare data to send
        const formData = new FormData(quizForm);
        const answers = {};
        
        // Convert FormData to JSON
        for (const [key, value] of formData.entries()) {
            answers[key] = value;
        }
        
        // Send data using fetch API
        fetch(quizForm.action, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ answers }),
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Show score and feedback
                questions.forEach((question) => {
                    const questionId = question.dataset.questionId;
                    const feedback = question.querySelector('.feedback-message');
                    const result = data.results[`q${questionId}`];
                    
                    if (result) {
                        feedback.classList.remove('hidden');
                        
                        if (result.correct) {
                            feedback.textContent = 'Correct!';
                            feedback.classList.add('text-green-600');
                        } else {
                            feedback.textContent = `Incorrect. The correct answer is: ${result.correctAnswer}`;
                            feedback.classList.add('text-red-600');
                        }
                    }
                });
                
                // Show completion message and next lesson link
                const completionMessage = document.createElement('div');
                completionMessage.className = 'fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50';
                completionMessage.innerHTML = `
                    <div class="bg-white p-8 rounded-lg shadow-xl max-w-md w-full">
                        <div class="text-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-green-500 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <h2 class="text-2xl font-bold text-gray-800 mt-4">Quiz Completed!</h2>
                            <p class="text-gray-600 mt-2">You scored ${data.score}% on this quiz.</p>
                        </div>
                        <div class="mt-6 flex justify-center space-x-4">
                            <button onclick="window.location.href='/program/${data.programID}/lessons/${data.nextLessonId || ''}';" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                                Next Lesson
                            </button>
                            <button onclick="window.location.href='/';" class="px-4 py-2 bg-gray-100 text-gray-800 rounded hover:bg-gray-200">
                                Return to Home
                            </button>
                        </div>
                    </div>
                `;
                document.body.appendChild(completionMessage);
            } else {
                alert('There was a problem processing your answers. Please try again.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred. Please try again.');
        });
    });
    
    // Initialize progress bar
    updateProgress();
});
</script>
{% endblock %}