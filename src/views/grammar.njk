{% extends "layout.njk" %}

{% block title %} Grammar {% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-6">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center">
            <div class="bg-blue-100 rounded-full p-3 mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Grammar Lessons</h1>
                <p class="text-sm text-gray-600">Master English grammar rules and structures</p>
            </div>
        </div>
    </div>

    <div class="mb-6 relative">
        <div class="relative">
            <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input 
                type="text" 
                id="search-bar" 
                class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm"
                placeholder="Search for a grammar lesson..." 
                oninput="filterLessons()"
            />
        </div>
        <div id="search-results-count" class="text-sm text-gray-500 mt-2">
            Showing all {{ lessons.length }} lessons
        </div>
    </div>
    
    <div id="lessons-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        {% for lesson in lessons %}
            <div style="opacity: 1; visibility: visible;" class="lesson-card bg-white border border-gray-200 rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300 flex flex-col h-full">
                <div class="p-5 flex-grow">
                    {% if lesson.lesson_content.category %}
                        <div class="inline-block px-3 py-1 mb-3 text-xs font-semibold text-blue-800 bg-blue-100 rounded-full">
                            {{ lesson.lesson_content.category }}
                        </div>
                    {% endif %}
                    <h2 class="text-lg font-bold text-gray-800 mb-3 lesson-title">{{ lesson.lesson_title }}</h2>
                    <p class="text-gray-600 text-sm mb-4 lesson-description">{{ lesson.lesson_content.description }}</p>
                    
                    {% if lesson.lesson_content.examples and lesson.lesson_content.examples|length > 0 %}
                        <div class="mt-3">
                            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Example:</span>
                            <p class="text-sm text-gray-800 italic mt-1">"{{ lesson.lesson_content.examples[0].example }}"</p>
                        </div>
                    {% endif %}
                </div>
                
                <div class="border-t border-gray-200 bg-gray-50 p-4 mt-auto">
                    <a href="grammar/lessons/{{ lesson.id }}" class="flex items-center justify-center px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors duration-200">
                        <span>Start Learning</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
    
    <div id="no-results" class="hidden text-center p-10 bg-gray-50 rounded-lg border border-gray-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="mt-2 text-lg font-medium text-gray-900">No lessons found</h3>
        <p class="mt-1 text-gray-500">Try adjusting your search term or browse all lessons.</p>        <button onclick="clearSearch()" class="mt-4 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors duration-200">
            Show All Lessons
        </button>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initial count display
        updateResultsCount();
          // Add animation to cards on page load with debugging
        const lessonCards = document.querySelectorAll('.lesson-card');
        console.log("Found " + lessonCards.length + " grammar lesson cards to animate");
        
        lessonCards.forEach((card, index) => {
            // Make card visible immediately
            card.style.opacity = "1";
            card.style.visibility = "visible";
            
            // Add animation with delay
            setTimeout(() => {
                card.classList.add('animate-slide-in');
            }, 50 * index);
        });
        
        // Add event listener for search input
        const searchBar = document.getElementById('search-bar');
        searchBar.addEventListener('input', debounce(filterLessons, 300));
          // Add styles for animations
        const style = document.createElement('style');
        style.textContent = `
            .lesson-card {
                opacity: 1 !important;
                visibility: visible !important;
                transform: translateY(0);
                transition: all 0.4s ease-out;
            }
            
            .lesson-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            }
            
            .lesson-card .example-text {
                transition: background-color 0.3s ease;
            }
            
            .lesson-card:hover .example-text {
                background-color: rgba(59, 130, 246, 0.1);
            }
            
            @keyframes fadeIn {
                from { opacity: 0; }
                to { opacity: 1; }
            }
            
            @keyframes slideIn {
                from { 
                    opacity: 0.7;
                    transform: translateY(10px); 
                }
                to { 
                    opacity: 1;
                    transform: translateY(0); 
                }
            }
        `;
        document.head.appendChild(style);
    });
    
    // Debounce function to improve search performance
    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    function filterLessons() {
        const query = document.getElementById('search-bar').value.toLowerCase().trim();
        const lessonCards = document.querySelectorAll('.lesson-card');
        const lessonsGrid = document.getElementById('lessons-grid');
        const noResults = document.getElementById('no-results');
        let visibleCount = 0;
        
        // If query is empty, show all cards
        if (!query) {
            lessonCards.forEach(card => {
                card.classList.remove('hidden');
                // Apply fade-in animation                card.style.animation = 'fadeIn 0.5s ease forwards';
                // Ensure card is visible
                card.style.opacity = "1";
                card.style.visibility = "visible";
                
                // Reset any highlighting
                resetHighlighting(card);
            });
            lessonsGrid.classList.remove('hidden');
            noResults.classList.add('hidden');
            updateResultsCount();
            return;
        }

        lessonCards.forEach(card => {
            const title = card.querySelector('.lesson-title').textContent.toLowerCase();
            const description = card.querySelector('.lesson-description').textContent.toLowerCase();
            
            // Reset any previous highlighting
            resetHighlighting(card);
            
            // Check for example sentences that might match
            let exampleMatch = false;
            const exampleEl = card.querySelector('.italic');
            if (exampleEl) {
                const exampleText = exampleEl.textContent.toLowerCase();
                exampleMatch = exampleText.includes(query);
                
                // Highlight matching example
                if (exampleMatch) {
                    highlightText(exampleEl, query);
                    // Add special class to make example more visible
                    exampleEl.classList.add('example-text');
                }
            }
            
            // Check for category match if available
            let categoryMatch = false;
            const categoryTag = card.querySelector('.inline-block.px-3.py-1.mb-3');
            if (categoryTag) {
                categoryMatch = categoryTag.textContent.toLowerCase().includes(query);
                if (categoryMatch) {
                    categoryTag.classList.add('ring-2', 'ring-blue-300');
                }
            }
            
            // Support for grammar rule specific searches
            let grammarRuleMatch = false;
            if (query.startsWith('rule:')) {
                const ruleQuery = query.substring(5).trim();
                // Look for specific grammar rules or keywords in the description
                grammarRuleMatch = description.includes(ruleQuery);
            }
            
            // Determine final match status
            const isMatch = title.includes(query) || 
                           description.includes(query) || 
                           exampleMatch || 
                           categoryMatch ||
                           grammarRuleMatch;
            
            // Show or hide based on match with animation
            if (isMatch) {
                card.classList.remove('hidden');
                visibleCount++;
                
                // Apply highlighting to title and description based on match
                const titleEl = card.querySelector('.lesson-title');
                const descriptionEl = card.querySelector('.lesson-description');
                
                if (title.includes(query)) {
                    highlightText(titleEl, query);
                }
                
                if (description.includes(query)) {
                    highlightText(descriptionEl, query);
                }
                  // Apply entrance animation and ensure visibility
                card.style.animation = 'slideIn 0.4s ease-out forwards';
                card.style.opacity = "1";
                card.style.visibility = "visible";
            } else {
                card.classList.add('hidden');
            }
        });

        // Show/hide no results message
        lessonsGrid.classList.toggle('hidden', visibleCount === 0);
        noResults.classList.toggle('hidden', visibleCount > 0);
        
        // Update the results count
        updateResultsCount(visibleCount);
    }
    
    function resetHighlighting(card) {
        // Reset text highlighting
        const highlightedElements = card.querySelectorAll('.bg-yellow-100');
        highlightedElements.forEach(el => {
            const parent = el.parentNode;
            if (parent) {
                parent.textContent = parent.textContent; // This removes the highlight spans
            }
        });
        
        // Reset category tag highlighting
        const categoryTag = card.querySelector('.inline-block.px-3.py-1.mb-3');
        if (categoryTag) {
            categoryTag.classList.remove('ring-2', 'ring-blue-300');
        }
        
        // Reset example highlighting
        const exampleEl = card.querySelector('.italic');
        if (exampleEl) {
            exampleEl.classList.remove('example-text');
        }
    }
    
    function highlightText(element, query) {
        if (!element) return;
        
        // Basic highlighting functionality
        const text = element.textContent;
        const lowerText = text.toLowerCase();
        const index = lowerText.indexOf(query.toLowerCase());
        
        if (index >= 0) {
            const before = text.substring(0, index);
            const match = text.substring(index, index + query.length);
            const after = text.substring(index + query.length);
            
            element.innerHTML = before + 
                               '<span class="bg-yellow-100 px-0.5 rounded">' + 
                               match + 
                               '</span>' + 
                               after;
        }
    }

    function updateResultsCount(count) {
        const totalCount = document.querySelectorAll('.lesson-card').length;
        const countElement = document.getElementById('search-results-count');
        
        if (count === undefined || count === totalCount) {
            countElement.textContent = `Showing all ${totalCount} grammar lessons`;
        } else {
            countElement.textContent = `Found ${count} of ${totalCount} matching lessons`;
        }
    }    function clearSearch() {
        const searchBar = document.getElementById('search-bar');
        searchBar.value = '';
        
        // Reset all cards
        document.querySelectorAll('.lesson-card').forEach(card => {
            resetHighlighting(card);
            // Ensure card visibility
            card.style.opacity = "1";
            card.style.visibility = "visible";
        });
        
        filterLessons();
        searchBar.focus();
    }
</script>
{% endblock %}