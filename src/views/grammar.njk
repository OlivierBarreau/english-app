{% extends "layout.njk" %}

{% block title %} Grammar {% endblock %}

{% block content %}

<p class="text-2xl my-2 ml-10"> Grammar </p>

<div class="my-4 ml-10">
    <input 
        type="text" 
        id="search-bar" 
        class="border border-gray-300 p-2 w-80" 
        placeholder="Search for a lesson..." 
        oninput="filterLessons()"
    />
</div>
<script>
    function filterLessons() {
        const query = document.getElementById('search-bar').value.toLowerCase();
        const lessons = document.querySelectorAll('.flex.flex-col.w-full.h-auto');
        lessons.forEach(lesson => {
            const title = lesson.querySelector('h2').textContent.toLowerCase();
            lesson.style.display = title.includes(query) ? 'block' : 'none';
        });
    }
</script>
    
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 overflow-y-auto h-96 px-4">
    {% for lesson in lessons %}
        <div class="flex flex-col w-full h-auto p-4 my-4 bg-blue-100 shadow-md">
            <h2 class="text-lg font-semibold text-blue-800 mb-2">{{ lesson.lesson_title }}</h2>
            <p class="text-sm text-gray-700 mb-2"><strong>Description:</strong> {{ lesson.lesson_content.description }}</p>
            <a href="/lessons/{{ lesson.id }}" class="inline-block px-4 py-2 text-white text-sm bg-blue-500 hover:bg-blue-600 transition w-32 text-center">
                View Lesson
            </a>
        </div>
    {% endfor %}
</div>
{% endblock %}