{% extends "layout.njk" %}

{% block title %} Program {% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-6">
  <div class="flex items-center mb-6">
    <div class="bg-blue-100 rounded-full p-2 mr-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 4v12l-4-2-4 2V4M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Welcome {{ user.firstname }}!</h1>
      <p class="text-sm text-gray-600">Your learning journey - complete lessons to progress</p>
    </div>
  </div>
  {# Progress summary section #}
  <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg p-6 mb-8 shadow-sm">
    <div class="flex flex-wrap items-center justify-between">
      <div class="mb-4 md:mb-0">
        <h2 class="text-xl font-bold text-blue-800">Your Learning Progress</h2>
        <p class="text-gray-600">Track your journey through English mastery</p>
      </div>
      <div class="flex items-center space-x-2">
        <div class="hidden md:flex items-center mr-4">
          <div class="w-3 h-3 rounded-full bg-green-500 mr-2"></div>
          <span class="text-sm text-gray-600">Completed</span>
        </div>
        <div class="hidden md:flex items-center">
          <div class="w-3 h-3 rounded-full bg-blue-500 mr-2"></div>
          <span class="text-sm text-gray-600">In Progress</span>
        </div>
      </div>
    </div>
    <div class="mt-4 bg-white rounded-lg p-4 shadow-inner">
      <div class="flex justify-between mb-2">
        <span class="text-sm font-medium text-gray-700">Overall Completion</span>
        <span class="text-sm font-medium text-blue-600" id="overall-progress-text">Calculating...</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-3">
        <div id="overall-progress-bar" class="bg-blue-600 h-3 rounded-full transition-all duration-1000 ease-out" style="width: 0%"></div>
      </div>
    </div>
  </div>

  {# This is where the SVG and lesson list wrapper go, specific to this page's content #}
  <div class="relative lessons-container-wrapper overflow-x-hidden overflow-y-auto scrollbar-thin scrollbar-thumb-gray-400 scrollbar-track-gray-200 pb-10">
    <svg id="lines-svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0;"></svg>
  <div class="flex flex-col space-y-16 max-w-5xl mx-auto">
      {% for lesson in lessons %}
        <div style="opacity: 1; visibility: visible;" class="lesson-block flex {% if loop.index % 2 == 0 %}justify-end{% else %}justify-start{% endif %} relative px-4">
          {% if not loop.first %}
          <div class="lesson-marker absolute left-1/2 transform -translate-x-1/2 -top-8">
            <div class="{% if lessons[loop.index0 - 1].lesson_completion == 100 %}bg-green-100 text-green-800{% else %}bg-blue-100 text-blue-800{% endif %} rounded-full px-3 py-1 text-xs font-semibold shadow-sm">
              Lesson {{ loop.index }}
            </div>
          </div>
          {% endif %}          <div class="w-full md:w-96 h-auto p-5 shadow-lg rounded-lg border-l-4 
                      {% if lesson.lesson_completion == 100 %}
                        bg-white border-green-500 hover:shadow-xl transition-all duration-300 lesson-completed
                      {% else %}
                        bg-white border-blue-500 hover:shadow-xl transition-all duration-300
                      {% endif %}">
            <div class="absolute -right-2 -top-2 
                      {% if lesson.lesson_completion == 100 %}
                        bg-green-500 text-white
                      {% else %}
                        bg-blue-500 text-white
                      {% endif %} 
                      rounded-full w-8 h-8 flex items-center justify-center shadow-md">
              <span class="text-sm font-bold">{{ loop.index }}</span>
            </div>
            
            <div class="flex items-center mb-3">
              <div class="{% if lesson.lesson_completion == 100 %}bg-green-100{% else %}bg-blue-100{% endif %} rounded-full p-2 mr-3 flex-shrink-0 h-10 w-10 flex items-center justify-center">
                {% if lesson.lesson_completion == 100 %}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                {% endif %}
              </div>
              <h2 class="text-xl font-semibold {% if lesson.lesson_completion == 100 %}text-green-800{% else %}text-gray-800{% endif %}">{{ lesson.lesson_title }}</h2>
            </div>

            <p class="text-gray-700 mb-4">{{ lesson.lesson_content.description | safe}}</p>

          {% if lesson.lesson_content.examples and lesson.lesson_content.examples|length > 0 %}
          <div class="bg-gray-50 rounded-md p-3 mb-4 border border-gray-100">
            <h3 class="text-sm font-medium text-gray-700 mb-2">Examples:</h3>
            <ul class="space-y-2">
              {% for example in lesson.lesson_content.examples %}
                <li class="flex">
                  <span class="text-blue-500 mr-2">•</span>
                  <span><span class="font-medium">{{ example.idiom }}</span>: {{ example.meaning }}</span>
                </li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
              <div class="flex justify-between items-center mb-1">
                <span class="text-sm font-medium text-gray-700">Completion</span>
                <div class="flex items-center">
                  <span class="text-sm font-medium {% if lesson.lesson_completion == 100 %}text-emerald-600{% else %}text-blue-600{% endif %}">
                    {{ lesson.lesson_completion }}%
                  </span>
                  {% if lesson.lesson_completion == 100 %}
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 text-emerald-500" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  {% endif %}
                </div>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="{% if lesson.lesson_completion == 100 %}bg-emerald-500{% else %}bg-blue-500{% endif %} h-2 rounded-full" 
                     style="width: {{ lesson.lesson_completion }}%"></div>
              </div>
            </div>
            
            <div>
              <div class="flex justify-between items-center mb-1">
                <span class="text-sm font-medium text-gray-700">Score</span>
                <div class="flex items-center">
                  <span class="text-sm font-medium {% if lesson.lesson_right_answer > 80 %}text-emerald-600{% else %}text-orange-600{% endif %}">
                    {{ lesson.lesson_right_answer }}%
                  </span>
                </div>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="{% if lesson.lesson_right_answer > 80 %}bg-emerald-500{% elif lesson.lesson_right_answer > 50 %}bg-yellow-500{% else %}bg-orange-500{% endif %} h-2 rounded-full" 
                     style="width: {{ lesson.lesson_right_answer }}%"></div>
              </div>
            </div>
          </div>          <a href="program/{{user.current_program_id}}/lessons/{{ lesson.id }}" 
             class="group relative inline-flex w-full items-center justify-center px-5 py-2.5 mt-2
                {% if lesson.lesson_completion == 100 %}
                  bg-gradient-to-r from-green-600 to-green-500
                {% else %}
                  bg-gradient-to-r from-blue-600 to-blue-500
                {% endif %}
                text-white text-sm font-medium rounded-md shadow-md hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 
                {% if lesson.lesson_completion == 100 %}
                  focus:ring-green-500
                {% else %}
                  focus:ring-blue-500
                {% endif %}">
            <span class="absolute right-0 -mt-12 h-32 w-8 translate-x-12 rotate-12 transform bg-white opacity-10 transition-all duration-1000 ease-out group-hover:-translate-x-40"></span>
            <span class="relative flex items-center">
              {% if lesson.lesson_completion == 100 %}
                <span>Review Completed Lesson</span>
              {% else %}
                <span>Continue Learning</span>
              {% endif %}
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
          </a>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
{% endblock %}

{# The JavaScript for drawing lines goes into the 'scripts' block #}
{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const lessonOuterBlocks = document.querySelectorAll('.lesson-block');
  const svgContainer = document.getElementById('lines-svg');
  const lessonsWrapper = document.querySelector('.lessons-container-wrapper');
  const completedLessons = document.querySelectorAll('.lesson-completed');
  
  // Calculate overall progress for the progress bar
  const totalLessons = lessonOuterBlocks.length;
  const completedCount = completedLessons.length;
  const progressPercentage = totalLessons > 0 ? Math.round((completedCount / totalLessons) * 100) : 0;
  
  // Update progress bar and text
  const progressBar = document.getElementById('overall-progress-bar');
  const progressText = document.getElementById('overall-progress-text');
  
  if (progressBar && progressText) {
    setTimeout(() => {
      progressBar.style.width = `${progressPercentage}%`;
      progressText.textContent = `${progressPercentage}% (${completedCount}/${totalLessons} lessons)`;
      
      // Change color if all lessons completed
      if (progressPercentage === 100) {
        progressBar.classList.remove('bg-blue-600');
        progressBar.classList.add('bg-green-600');
      }
    }, 300);
  }

  if (!lessonOuterBlocks || lessonOuterBlocks.length < 2 || !svgContainer || !lessonsWrapper) {
    return;
  }  // Simple and direct animation approach
  lessonOuterBlocks.forEach((block, index) => {
    // Apply animation class with a slight delay between each lesson
    setTimeout(() => {
      block.classList.add('animate-slide-in');
    }, 100 * index);
  });

  function drawCurvedConnections() {
    svgContainer.innerHTML = ''; 
    const wrapperRect = lessonsWrapper.getBoundingClientRect();
    
    // Create SVG defs for markers
    const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
    
    // Create marker for incomplete lessons
    const markerIncomplete = document.createElementNS('http://www.w3.org/2000/svg', 'marker');
    markerIncomplete.setAttribute('id', 'arrow-incomplete');
    markerIncomplete.setAttribute('viewBox', '0 0 10 10');
    markerIncomplete.setAttribute('refX', '5');
    markerIncomplete.setAttribute('refY', '5');
    markerIncomplete.setAttribute('markerWidth', '6');
    markerIncomplete.setAttribute('markerHeight', '6');
    markerIncomplete.setAttribute('orient', 'auto-start-reverse');
    
    const markerPathIncomplete = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    markerPathIncomplete.setAttribute('d', 'M 0 0 L 10 5 L 0 10 z');
    markerPathIncomplete.setAttribute('fill', 'rgba(59, 130, 246, 0.8)');
    markerIncomplete.appendChild(markerPathIncomplete);
    
    // Create marker for completed lessons
    const markerComplete = document.createElementNS('http://www.w3.org/2000/svg', 'marker');
    markerComplete.setAttribute('id', 'arrow-complete');
    markerComplete.setAttribute('viewBox', '0 0 10 10');
    markerComplete.setAttribute('refX', '5');
    markerComplete.setAttribute('refY', '5');
    markerComplete.setAttribute('markerWidth', '6');
    markerComplete.setAttribute('markerHeight', '6');
    markerComplete.setAttribute('orient', 'auto-start-reverse');
    
    const markerPathComplete = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    markerPathComplete.setAttribute('d', 'M 0 0 L 10 5 L 0 10 z');
    markerPathComplete.setAttribute('fill', 'rgba(16, 185, 129, 0.8)');
    markerComplete.appendChild(markerPathComplete);
    
    defs.appendChild(markerIncomplete);
    defs.appendChild(markerComplete);
    svgContainer.appendChild(defs);

    for (let i = 0; i < lessonOuterBlocks.length - 1; i++) {
      const currentLessonOuterDiv = lessonOuterBlocks[i];
      const nextLessonOuterDiv = lessonOuterBlocks[i+1];
      const currentLessonCard = currentLessonOuterDiv.querySelector(':scope > div');
      const nextLessonCard = nextLessonOuterDiv.querySelector(':scope > div');

      if (!currentLessonCard || !nextLessonCard) continue;

      // Calculate positions
      const rect1 = currentLessonCard.getBoundingClientRect();
      const rect2 = nextLessonCard.getBoundingClientRect();
      
      // Determine if left or right for current and next
      const isCurrentRight = i % 2 !== 0;
      const isNextRight = (i + 1) % 2 !== 0;
      
      // Calculate start and end points
      let startX, startY, endX, endY;
      
      // Current card bottom center
      startX = rect1.left + rect1.width / 2 - wrapperRect.left;
      startY = rect1.bottom - wrapperRect.top;
      
      // Next card top center
      endX = rect2.left + rect2.width / 2 - wrapperRect.left;
      endY = rect2.top - wrapperRect.top;
      
      // Create group for this connection
      const connectionGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      connectionGroup.setAttribute('class', 'path-group');
      
      // Create path for curved line
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      
      // Calculate enhanced control points for smoother curve
      const verticalDistance = endY - startY;
      const horizontalOffset = Math.min(Math.abs(rect1.left - rect2.left) * 0.3, 100);
      
      // Adjust control points based on card positions and vertical distance for smoother curves
      const ctrlPt1X = isCurrentRight ? startX + horizontalOffset : startX - horizontalOffset;
      const ctrlPt1Y = startY + verticalDistance * 0.25;
      const ctrlPt2X = isNextRight ? endX + horizontalOffset : endX - horizontalOffset;
      const ctrlPt2Y = endY - verticalDistance * 0.25;
      
            // Create the bezier curve path
      const pathD = `M ${startX} ${startY} C ${ctrlPt1X} ${ctrlPt1Y}, ${ctrlPt2X} ${ctrlPt2Y}, ${endX} ${endY}`;
      
      // Add animation and styling to the path
      path.setAttribute('d', pathD);
      path.setAttribute('fill', 'none');
      
      // Check lesson completion status
      const isCompleted = currentLessonCard.classList.contains('lesson-completed');
      console.log(isCompleted);
      if (isCompleted) {
        path.setAttribute('stroke', 'rgba(16, 185, 129, 0.8)');
        path.setAttribute('marker-end', 'url(#arrow-complete)');
        path.classList.add('completed-path');
      } else {
        path.setAttribute('stroke', 'rgba(59, 130, 246, 0.7)');
        path.setAttribute('marker-end', 'url(#arrow-incomplete)');
      }
      
      path.setAttribute('stroke-width', '3');
      path.setAttribute('stroke-linecap', 'round');
      
      // Add animation properties
      path.style.strokeDasharray = path.getTotalLength();
      path.style.strokeDashoffset = path.getTotalLength();
      path.style.animation = `drawPath 1.5s ease-in-out ${i * 0.3}s forwards`;
      
      if (isCompleted) {
        path.setAttribute('stroke-dasharray', '8, 3');
      }
      
      connectionGroup.appendChild(path);
      
      // Add checkpoints/nodes at start of path
      const startPoint = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      startPoint.setAttribute('cx', startX);
      startPoint.setAttribute('cy', startY);
      startPoint.setAttribute('r', '5');
      startPoint.setAttribute('fill', isCompleted ? 'rgba(16, 185, 129, 1)' : 'rgba(59, 130, 246, 1)');
      startPoint.setAttribute('stroke', 'white');
      startPoint.setAttribute('stroke-width', '2');
      startPoint.classList.add('path-node');
      
      // Add animation for nodes
      startPoint.style.opacity = '0';
      startPoint.style.animation = `fadeIn 0.5s ease-in-out ${i * 0.3 + 0.2}s forwards`;
      
      // Add pulse effect for nodes
      if (!isCompleted) {
        const pulseCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        pulseCircle.setAttribute('cx', startX);
        pulseCircle.setAttribute('cy', startY);
        pulseCircle.setAttribute('r', '5');
        pulseCircle.setAttribute('fill', 'rgba(59, 130, 246, 0.5)');
        pulseCircle.classList.add('pulse-circle');
        connectionGroup.appendChild(pulseCircle);
      }
      
      connectionGroup.appendChild(startPoint);
      svgContainer.appendChild(connectionGroup);
    }
  }  // We'll use just what we need for connections since the rest is in the CSS file
  const style = document.createElement('style');
  style.textContent = `
    @keyframes drawPath {
      to {
        stroke-dashoffset: 0;
      }
    }
    
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  `;
  document.head.appendChild(style);

  drawCurvedConnections();
  
  // Handle resize with debounce
  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(drawCurvedConnections, 150);
  });
  
  // Redraw when images load to ensure proper positioning
  window.addEventListener('load', drawCurvedConnections);
});
</script>
{% endblock %}