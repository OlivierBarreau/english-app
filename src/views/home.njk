{% extends "layout.njk" %}

{% block title %} Program {% endblock %}

{% block content %}
<h1 class="text-2xl my-2 ml-10">Welcome {{ user.firstname }}!</h1>
<p class="ml-10 mb-4 text-gray-600">Here is your program:</p>

<div class="flex flex-col space-y-8">
  {% for lesson in lessons %}
    <div class="flex {% if loop.index % 2 == 0 %}justify-end{% else %}justify-start{% endif %} px-100">
      <div class="w-80 h-auto p-4 bg-blue-100 shadow-md rounded-md">
        <h2 class="text-lg font-semibold text-blue-800 mb-2">{{ lesson.lesson_title }}</h2>
        <p class="text-sm text-gray-700 mb-2"><strong>Description:</strong> {{ lesson.lesson_content.description }}</p>

        <div class="text-sm text-gray-700 mb-2">
          <strong>Examples:</strong>
          <ul class="list-disc ml-5 mt-1">
            {% for example in lesson.lesson_content.examples %}
              <li><strong>{{ example.idiom }}</strong>: {{ example.meaning }}</li>
            {% endfor %}
          </ul>
        </div>

        <div class="mt-4 text-sm text-gray-700">
          <strong>Completion:</strong> {{ lesson.lesson_completion }}%
        </div>
        <div class="text-sm text-gray-700">
          <strong>Result:</strong> {{ lesson.lesson_right_answer }}%
        </div>

        <a href="/lessons/{{ lesson.id }}" class="inline-block mt-2 px-4 py-2 text-white text-sm bg-blue-500 rounded hover:bg-blue-600 transition">
          View Lesson
        </a>
      </div>
    </div>
  {% endfor %}
</div>

{% endblock %}
