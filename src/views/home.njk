{% extends "layout.njk" %}

{% block title %} Program {% endblock %}

{% block content %}
<h1 class="text-2xl my-2 ml-10">Welcome {{ user.firstname }}!</h1>
<p class="ml-10 mb-4 text-gray-600">Here is your program:</p>

{# This is where the SVG and lesson list wrapper go, specific to this page's content #}
<div class="relative lessons-container-wrapper">
  <svg id="lines-svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0;"></svg>

  <div class="flex flex-col space-y-8">
    {% for lesson in lessons %}
      <div class="lesson-block flex {% if loop.index % 2 == 0 %}justify-end{% else %}justify-start{% endif %} px-100">
        <div class="w-80 h-auto p-4 shadow-md rounded-md
                    {% if lesson.lesson_completion == 100 %}
                      bg-gray-200 text-gray-500
                    {% else %}
                      bg-blue-100
                    {% endif %}">
          
          <h2 class="text-lg font-semibold text-blue-800 mb-2">{{ lesson.lesson_title }}</h2>
          <p class="text-sm text-gray-700 mb-2"><strong>Description:</strong> {{ lesson.lesson_content.description }}</p>
          <div class="text-sm text-gray-700 mb-2">
            <strong>Examples:</strong>
            <ul class="list-disc ml-5 mt-1">
              {% for example in lesson.lesson_content.examples %}
                <li><strong>{{ example.idiom }}</strong>: {{ example.meaning }}</li>
              {% endfor %}
            </ul>
          </div>
          <div class="mt-4 text-sm text-gray-700">
            <strong>Completion:</strong> {{ lesson.lesson_completion }}%
          </div>
          <div class="text-sm text-gray-700">
            <strong>Result:</strong> {{ lesson.lesson_right_answer }}%
          </div>
          <a href="/lessons/{{ lesson.id }}" class="inline-block mt-2 px-4 py-2 text-white text-sm bg-blue-500 rounded hover:bg-blue-600 transition">
            View Lesson
          </a>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
{% endblock %}

{# The JavaScript for drawing lines goes into the 'scripts' block #}
{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const lessonOuterBlocks = document.querySelectorAll('.lesson-block');
  const svgContainer = document.getElementById('lines-svg');
  const lessonsWrapper = document.querySelector('.lessons-container-wrapper');

  if (!lessonOuterBlocks || lessonOuterBlocks.length < 2 || !svgContainer || !lessonsWrapper) {
    // console.warn('Required elements for drawing diagonal lines are missing on this page.');
    return;
  }

  function drawDiagonalLines() {
    svgContainer.innerHTML = ''; 
    const wrapperRect = lessonsWrapper.getBoundingClientRect();

    for (let i = 0; i < lessonOuterBlocks.length - 1; i++) {
      const currentLessonOuterDiv = lessonOuterBlocks[i];
      const nextLessonOuterDiv = lessonOuterBlocks[i+1];
      const currentLessonCard = currentLessonOuterDiv.querySelector(':scope > div');
      const nextLessonCard = nextLessonOuterDiv.querySelector(':scope > div');

      if (!currentLessonCard || !nextLessonCard) {
        // console.warn('Could not find lesson card elements for line drawing.');
        continue;
      }

      const rect1 = currentLessonCard.getBoundingClientRect();
      const rect2 = nextLessonCard.getBoundingClientRect();
      const startXViewport = rect1.left + rect1.width / 2;
      const startYViewport = rect1.bottom;
      const endXViewport = rect2.left + rect2.width / 2;
      const endYViewport = rect2.top;
      const x1 = startXViewport - wrapperRect.left;
      const y1 = startYViewport - wrapperRect.top;
      const x2 = endXViewport - wrapperRect.left;
      const y2 = endYViewport - wrapperRect.top;

      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', x1.toString());
      line.setAttribute('y1', y1.toString());
      line.setAttribute('x2', x2.toString());
      line.setAttribute('y2', y2.toString());
      line.setAttribute('stroke', 'rgba(107, 114, 128, 0.6)'); 
      line.setAttribute('stroke-width', '2');
      svgContainer.appendChild(line);
    }
  }

  drawDiagonalLines();
  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(drawDiagonalLines, 150);
  });
});
</script>
{% endblock %}