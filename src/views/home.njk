{% extends "layout.njk" %}

{% block title %} Home {% endblock %}

{% block content %}
<h1 class="text-2xl my-2 ml-10">Welcome {{ user.firstname }}!</h1>
<p>This is a sample homepage using Nunjucks.</p>
<div class="flex flex-col justify-around overflow-y-auto">
  {% for lesson in lessons %}
    <div class="flex flex-col w-80 h-auto p-4 my-4 bg-blue-100 shadow-md">
      <h2 class="text-lg font-semibold text-blue-800 mb-2">{{ lesson.lesson_title }}</h2>
      <p class="text-sm text-gray-700 mb-2"><strong>Description:</strong> {{ lesson.lesson_content.description }}</p>
      <p class="text-sm text-gray-700 mb-2"><strong>Examples:</strong> {{ lesson.lesson_content.examples }}</p>
      <a href="/lessons/{{ lesson.id }}" class="inline-block px-4 py-2 text-white text-sm bg-blue-500 hover:bg-blue-600 transition w-32 text-center">
                View Lesson
      </a>
    </div>
  {% endfor %}
</div>
{# {% if lessons.length == 0 %}
  <p>No lessons available.</p>
{% endif %} #}

{% endblock %}
