{% extends "layout.njk" %}

{% block title %} TOEIC Introduction {% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <div class="bg-blue-600 px-6 py-4">
            <h1 class="text-3xl font-bold text-white">TOEIC Test Simulation</h1>
        </div>
        
        <div class="p-6">
            <div class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-800 mb-4">Welcome to the TOEIC Test Simulation</h2>
                <p class="text-gray-600">
                    This simulation is designed to help you prepare for the actual TOEIC test. It follows the same format and timing 
                    as the real test, giving you an authentic practice experience.
                </p>
            </div>

            <div class="mb-8">
                <h3 class="text-xl font-semibold text-blue-800 mb-2">Test Structure</h3>
                <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-4">
                    <p class="text-blue-700"><strong>Total Duration:</strong> 2 hours</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white border rounded-lg p-5 shadow-sm">
                        <div class="flex items-center mb-3">
                            <div class="bg-blue-100 rounded-full p-2 mr-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                                </svg>
                            </div>
                            <h4 class="text-lg font-medium text-gray-800">Listening Section</h4>
                        </div>
                        <ul class="list-disc list-inside text-gray-600 space-y-1 ml-2">
                            <li>Duration: <span class="font-medium">45 minutes</span></li>
                            <li>Photographs</li>
                            <li>Question-Response</li>
                            <li>Conversations</li>
                            <li>Short Talks</li>
                        </ul>
                    </div>
                    
                    <div class="bg-white border rounded-lg p-5 shadow-sm">
                        <div class="flex items-center mb-3">
                            <div class="bg-blue-100 rounded-full p-2 mr-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                </svg>
                            </div>
                            <h4 class="text-lg font-medium text-gray-800">Reading Section</h4>
                        </div>
                        <ul class="list-disc list-inside text-gray-600 space-y-1 ml-2">
                            <li>Duration: <span class="font-medium">75 minutes</span></li>
                            <li>Incomplete Sentences</li>
                            <li>Text Completion</li>
                            <li>Single Passages</li>
                            <li>Multiple Passages</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mb-8">
                <h3 class="text-xl font-semibold text-blue-800 mb-2">Important Instructions</h3>
                <ul class="list-disc list-inside text-gray-600 space-y-2">
                    <li>Each section has a strict time limit. When the time is up, your answers will be automatically submitted.</li>
                    <li>You must complete the listening section before proceeding to the reading section.</li>
                    <li>Once you start the test, you should not leave or refresh the page until you complete the section.</li>
                    <li>After completing the test, you will receive a score that simulates the actual TOEIC scoring system.</li>
                </ul>
            </div>
            
            <div class="mt-8 flex justify-center">
                <form action="/toeic/start" method="POST">
                    <button type="submit" class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md shadow transition duration-150 ease-in-out flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                        </svg>
                        Start TOEIC Test
                    </button>
                </form>
            </div>
            
            <div class="mt-6 text-center">
                <a href="/toeic/history" class="text-blue-600 hover:text-blue-800 font-medium">
                    View Past Test Results
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}