{% extends "layout.njk" %}

{% block title %} Profile {% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Header with avatar -->
    <div class="flex flex-row items-center pb-6 border-b border-gray-200">
        <div class="bg-blue-100 rounded-full p-3">
            <img class="h-16 w-16" src="/images/utilisateur.png" alt="User profile">
        </div>
        <div class="ml-6">
            <h1 class="text-3xl font-bold text-gray-800">{{ userInfo.firstname }} {{ userInfo.lastname }}</h1>
            <p class="text-gray-600">{{ userInfo.login }}</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
        <!-- Profile Information Card -->
        <div class="md:col-span-2">
            <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
                <h2 class="text-xl font-semibold mb-4 text-gray-800 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    Personal Information
                </h2>
                <div class="space-y-4">
                    <div class="flex border-b border-gray-100 pb-3">
                        <div class="w-1/3 font-medium text-gray-500">Email</div>
                        <div class="w-2/3 text-gray-800">{{ userInfo.login }}</div>
                    </div>
                    <div class="flex border-b border-gray-100 pb-3">
                        <div class="w-1/3 font-medium text-gray-500">First Name</div>
                        <div class="w-2/3 text-gray-800">{{ userInfo.firstname }}</div>
                    </div>
                    <div class="flex border-b border-gray-100 pb-3">
                        <div class="w-1/3 font-medium text-gray-500">Last Name</div>
                        <div class="w-2/3 text-gray-800">{{ userInfo.lastname }}</div>
                    </div>
                    <div class="flex items-center">
                        <a href="change-password" class="flex items-center px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-md transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                            </svg>
                            Change Password
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- English Level Card -->
        <div class="md:col-span-1">
            <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
                <h2 class="text-xl font-semibold mb-4 text-gray-800 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                    </svg>
                    English Level
                </h2>
                
                <div class="flex flex-col items-center">
                    <div class="w-32 h-32 rounded-full bg-blue-50 border-4 border-blue-500 flex items-center justify-center">
                        <span class="text-3xl font-bold text-blue-700">{{ userInfo.english_lvl }}</span>
                    </div>
                    
                    <div class="mt-4 text-center">
                        {% if userInfo.english_lvl == "A1" %}
                            <span class="text-sm text-gray-600">Beginner</span>
                        {% elif userInfo.english_lvl == "A2" %}
                            <span class="text-sm text-gray-600">Elementary</span>
                        {% elif userInfo.english_lvl == "B1" %}
                            <span class="text-sm text-gray-600">Intermediate</span>
                        {% elif userInfo.english_lvl == "B2" %}
                            <span class="text-sm text-gray-600">Upper Intermediate</span>
                        {% elif userInfo.english_lvl == "C1" %}
                            <span class="text-sm text-gray-600">Advanced</span>
                        {% elif userInfo.english_lvl == "C2" %}
                            <span class="text-sm text-gray-600">Proficient</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Program Information -->
    <div class="bg-white rounded-lg shadow-lg p-6 mt-6">
        <h2 class="text-xl font-semibold mb-4 text-gray-800 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Your Program
        </h2>
        
        {% if userInfo.current_program_id %}
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-700">You are currently enrolled in a program.</p>
                    <p class="text-sm text-gray-500 mt-1">Program ID: {{ userInfo.current_program_id }}</p>
                </div>
                <a href="/" class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-md transition">
                    View Program
                </a>
            </div>
        {% else %}
            <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 text-yellow-700">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm">You are not currently enrolled in any program.</p>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}