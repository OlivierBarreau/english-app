{% extends "layout.njk" %}

{% block title %} Profile {% endblock %}

{% block content %}

<div class="flex flex-row mt-2 items-center">
    <img class="h-10 w-auto" src="utilisateur.png" alt="utilisateur">
    <p class="text-2xl my-2 ml-4"> Profile </p>
</div>

<p class="text-xl my-2 ml-10"> Personal information </p>

<div class="flex flex-col mt-2">
    <p class="text-sm text-gray-700 mb-2 ml-4"><strong>Email:</strong> {{ userInfo.login }}</p>
    <p class="text-sm text-gray-700 mb-2 ml-4"><strong>First Name:</strong> {{ userInfo.firstname }}</p>
    <p class="text-sm text-gray-700 mb-2 ml-4"><strong>Last Name:</strong> {{ userInfo.lastname }}</p>
    <p class="text-sm text-gray-700 mb-2 ml-4"><strong>English Level:</strong> {{ userInfo.english_lvl }}</p>
    <a href="change-password" class="text-sm text-blue-500 hover:underline ml-4">Change Password</a>
</div>

<p class="text-xl my-2 ml-10"> Programs </p>

{% endblock %}