{% extends "layout.njk" %}

{% block title %} TOEIC Test Results {% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-6">
        <a href="/toeic/history" class="inline-flex items-center text-blue-600 hover:text-blue-800">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Back to Test History
        </a>
    </div>

    <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <div class="bg-blue-600 px-6 py-4">
            <h1 class="text-2xl font-bold text-white">TOEIC Test Results</h1>
            <p class="text-blue-100 text-sm mt-1">
                Test completed on {{ result.completion_date | formatDate('MMMM') }}
            </p>
        </div>

        <!-- Score Overview -->
        <div class="p-6">
            <div class="bg-gray-50 rounded-lg p-5 mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Score Overview</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Listening Score -->
                    <div class="bg-white rounded-lg border border-gray-200 p-5 text-center">
                        <div class="w-24 h-24 flex items-center justify-center mx-auto mb-3 rounded-full bg-blue-50">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                            </svg>
                        </div>
                        <h3 class="text-sm font-medium text-gray-500 mb-1">Listening Score</h3>
                        <p class="text-3xl font-bold text-blue-600">{{ result.listening_score }}</p>
                        <p class="text-sm text-gray-500 mt-1">out of 495</p>
                    </div>
                    
                    <!-- Reading Score -->
                    <div class="bg-white rounded-lg border border-gray-200 p-5 text-center">
                        <div class="w-24 h-24 flex items-center justify-center mx-auto mb-3 rounded-full bg-purple-50">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                            </svg>
                        </div>
                        <h3 class="text-sm font-medium text-gray-500 mb-1">Reading Score</h3>
                        <p class="text-3xl font-bold text-purple-600">{{ result.reading_score }}</p>
                        <p class="text-sm text-gray-500 mt-1">out of 495</p>
                    </div>
                    
                    <!-- Total Score -->
                    <div class="bg-white rounded-lg border border-gray-200 p-5 text-center">
                        <div class="w-24 h-24 flex items-center justify-center mx-auto mb-3 rounded-full bg-green-50">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="text-sm font-medium text-gray-500 mb-1">Total TOEIC Score</h3>
                        <p class="text-3xl font-bold text-green-600">{{ result.total_score }}</p>
                        <p class="text-sm text-gray-500 mt-1">out of 990</p>
                    </div>
                </div>
                
                <!-- Score interpretation -->
                <div class="mt-6 p-4 bg-blue-50 border-l-4 border-blue-500 rounded">
                    <h3 class="font-medium text-blue-800 mb-2">Score Interpretation</h3>
                    <ul class="list-disc list-inside space-y-1 text-sm text-blue-700">
                        <li>10-250: Beginner (A1-A2)</li>
                        <li>255-400: Intermediate (A2-B1)</li>
                        <li>405-600: Upper Intermediate (B1-B2)</li>
                        <li>605-780: Advanced (B2-C1)</li>
                        <li>785-990: Proficient (C1-C2)</li>
                    </ul>
                </div>
            </div>
            
            <!-- Skill Breakdown -->
            <div class="mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Skill Breakdown</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Listening Skills -->
                    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                        <div class="bg-blue-100 px-4 py-2 border-b border-gray-200">
                            <h3 class="font-medium text-blue-800">Listening Skills</h3>
                        </div>
                        <div class="p-4">
                            <ul class="space-y-4">
                                <li>
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-sm font-medium text-gray-700">Understanding Main Ideas</span>
                                        <span class="text-sm text-gray-600">{{ (result.listening_score / 5 * 4)|round }}%</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="bg-blue-600 h-2 rounded-full" style="width: {{ (result.listening_score / 5 * 4)|round }}%"></div>
                                    </div>
                                </li>
                                <li>
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-sm font-medium text-gray-700">Understanding Details</span>
                                        <span class="text-sm text-gray-600">{{ (result.listening_score / 5 * 3.5)|round }}%</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="bg-blue-600 h-2 rounded-full" style="width: {{ (result.listening_score / 5 * 3.5)|round }}%"></div>
                                    </div>
                                </li>
                                <li>
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-sm font-medium text-gray-700">Understanding Purpose</span>
                                        <span class="text-sm text-gray-600">{{ (result.listening_score / 5 * 4.2)|round }}%</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="bg-blue-600 h-2 rounded-full" style="width: {{ (result.listening_score / 5 * 4.2)|round }}%"></div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                    
                    <!-- Reading Skills -->
                    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                        <div class="bg-purple-100 px-4 py-2 border-b border-gray-200">
                            <h3 class="font-medium text-purple-800">Reading Skills</h3>
                        </div>
                        <div class="p-4">
                            <ul class="space-y-4">
                                <li>
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-sm font-medium text-gray-700">Grammar & Vocabulary</span>
                                        <span class="text-sm text-gray-600">{{ (result.reading_score / 5 * 3.8)|round }}%</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="bg-purple-600 h-2 rounded-full" style="width: {{ (result.reading_score / 5 * 3.8)|round }}%"></div>
                                    </div>
                                </li>
                                <li>
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-sm font-medium text-gray-700">Text Comprehension</span>
                                        <span class="text-sm text-gray-600">{{ (result.reading_score / 5 * 4)|round }}%</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="bg-purple-600 h-2 rounded-full" style="width: {{ (result.reading_score / 5 * 4)|round }}%"></div>
                                    </div>
                                </li>
                                <li>
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-sm font-medium text-gray-700">Critical Analysis</span>
                                        <span class="text-sm text-gray-600">{{ (result.reading_score / 5 * 3.5)|round }}%</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="bg-purple-600 h-2 rounded-full" style="width: {{ (result.reading_score / 5 * 3.5)|round }}%"></div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Recommendations -->
            <div class="mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Recommendations</h2>
                
                <div class="bg-white rounded-lg border border-gray-200 p-5">
                    <ul class="space-y-4">
                        {% if result.listening_score < 300 %}
                        <li class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500 mr-2 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <h4 class="font-medium text-gray-800">Improve Listening Skills</h4>
                                <p class="text-gray-600 text-sm">Practice listening to English podcasts, watch English TV shows with subtitles, and try dictation exercises to improve your listening comprehension.</p>
                            </div>
                        </li>
                        {% endif %}
                        
                        {% if result.reading_score < 300 %}
                        <li class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500 mr-2 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <h4 class="font-medium text-gray-800">Enhance Reading Comprehension</h4>
                                <p class="text-gray-600 text-sm">Read English books, articles, and business texts regularly. Focus on vocabulary building and grammar practice to improve your reading skills.</p>
                            </div>
                        </li>
                        {% endif %}
                        
                        <li class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500 mr-2 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <h4 class="font-medium text-gray-800">Practice Test Strategies</h4>
                                <p class="text-gray-600 text-sm">Continue taking practice tests to improve your time management and get familiar with the test format and question types.</p>
                            </div>
                        </li>
                        
                        <li class="flex items-start">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500 mr-2 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <h4 class="font-medium text-gray-800">Work on Vocabulary</h4>
                                <p class="text-gray-600 text-sm">Build your vocabulary by focusing on business terms, idioms, and commonly used phrases in professional settings.</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="flex justify-center mt-10">
                <a href="/toeic" class="px-6 py-3 bg-blue-600 text-white font-medium rounded-md shadow hover:bg-blue-700 transition">
                    Take Another TOEIC Test
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
